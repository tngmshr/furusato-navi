  "calculations": {
    "種別": "個人データのない合成条件。税務申告用の正確な計算器ではない。",
    "前提": {
      "年分": 2026,
      "給与収入": 5000000,
      "給与所得控除の速算値": 1440000,
      "給与所得の仮定値": 3560000,
      "社会保険料の仮定値": 750000,
      "所得税基礎控除": 1040000,
      "他の所得控除": 0,
      "税額控除": 0,
      "寄附額": 60000,
      "合成の住民税所得割額": 235500
    },
    "出典ID": [
      "N01",
      "N03",
      "N04",
      "N05",
      "N06",
      "N07"
    ],
    "注意": [
      "社会保険料75万円は年収の15%の仮置き。法定の一律保険料率ではない。",
      "給与所得356万円は速算式による合成入力。660万円未満の別表第五の当該行は未照合。",
      "住民税所得割額235,500円は上限感度を見る合成入力。基礎控除・調整控除等からの確定算定ではない。",
      "2026年12月1日原則施行・2026年分適用の改正後を使う通常の居住者を仮定。施行前死亡・出国等は除外。",
      "住民税特例分の税率判定、所得税との税率差、各税の端数処理、住宅ローン控除・分離課税等は未検証。"
    ],
    "算式": {
      "給与所得控除の速算": "5,000,000×20%＋440,000＝1,440,000円",
      "所得税課税所得": "3,560,000−750,000−1,040,000＝1,770,000円",
      "税率": "所得税率5%、2026年の復興特別所得税を含め5.105%",
      "所得税等軽減概算": "(60,000−2,000)×5%×1.021＝2,960.9円",
      "現行表示の暗黙の概算": "(60,000−2,000)×10%×1.021＝5,921.8円",
      "住民税基本分概算": "(60,000−2,000)×10%＝5,800円",
      "上限未達を仮定した住民税特例分": "(60,000−2,000)×(90%−5%×1.021)＝49,239.1円",
      "単純モデルの全額控除上限": "2,000＋住民税所得割額×20%÷(90%−所得税率×1.021)",
      "合成所得割額での上限": "2,000＋235,500×20%÷0.84895 ≒57,479.12円",
      "上限未達を仮定した住民税合計": "5,800＋49,239.1＝55,039.1円",
      "月平均": "58,000÷12≒4,833.33円",
      "調達費用の算術のみ": "60,000×30%＝18,000円。市場価値・利用者利益へ読み替えない。"
    },
    "結論": "所得税約5,900円を固定する例は見直しが必要。約57,479円は合成Rと単純モデルの感度計算で、年収500万円の2026年確定上限ではない。"
  }
